# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- cognito (make deploy-auth) ---
# Supply the Google values as exported variables or in ignored
# .env.auth.local. Never commit real values. The secret is used only by
# Cognito and is never exposed to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COGNITO_DOMAIN_PREFIX=sofia-peach
AUTH_CALLBACK_URL=https://www.sofia-peach.pp.ua/login/
AUTH_LOGOUT_URL=https://www.sofia-peach.pp.ua/login/

# --- written by the scripts, not by hand ---
# make deploy-auth writes only these public Cognito identifiers.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
